{
  "name": "counter-strike-1.6",
  "version": "1.6.0",
  "description": "Counter-Strike 1.6 - 3D Web Edition (Standalone Desktop & Android)",
  "main": "main.js",
  "author": "Counter-Strike Web Community",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "app": "electron .",
    "desktop": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android"
  },
  "devDependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/cli": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "electron": "^28.2.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.valvesoftware.cs16web",
    "productName": "Counter-Strike 1.6",
    "mac": {
      "category": "public.app-category.action-games",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
